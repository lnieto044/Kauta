# Kauta en Vercel (Container Runtime): la misma imagen que el Dockerfile, con Tesseract para el OCR, escuchando en $PORT.
# En Vercel el disco es temporal y puede haber varias instancias a la vez: la base es PostgreSQL (Neon, conectada al
# proyecto) y las claves vienen de las variables del proyecto. Ver «Desplegar en Vercel» en el README.

# Etapa 1: compila la pantalla (React + TypeScript + Tailwind)
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# Etapa 2: servidor Python con el lector local (Tesseract con español e inglés) y usuario sin privilegios
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 KAUTA_VAR=/tmp/kauta PORT=8080
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 kauta
# El modelo de español estándar de tessdata (el paquete de Debian trae el «rápido», que lee peor las facturas);
# es el mismo con que se midió el lector (scripts/medir_ocr.py) y se comprueba su huella
RUN python -c "import hashlib, urllib.request as u; d = u.urlopen('https://github.com/tesseract-ocr/tessdata/raw/main/spa.traineddata', timeout=120).read(); assert hashlib.sha256(d).hexdigest() == '0b0fcbb4665189e01ab8019e591f014dd7260460de072543edd4b2cb4ede7c96', 'spa.traineddata distinto'; open('/usr/share/tesseract-ocr/5/tessdata/spa.traineddata', 'wb').write(d)"
WORKDIR /app
COPY requirements-servidor.txt .
RUN pip install -r requirements-servidor.txt
COPY kauta/ kauta/
COPY servidor/ servidor/
COPY data/ data/
COPY facturas_de_prueba/ facturas_de_prueba/
COPY --from=web /web/dist web/dist
USER kauta
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn servidor.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*' --no-server-header"]
